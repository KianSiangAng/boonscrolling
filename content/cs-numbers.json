  "cards": [
    {
      "id": "byte",
      "type": "fact",
      "emoji": "🧱",
      "title": "One byte",
      "text": "A byte is 8 bits, so it can hold 2⁸ = 256 different values: 0 to 255 unsigned."
    },
    {
      "id": "hex-nibble",
      "type": "fact",
      "emoji": "🎨",
      "title": "Why hex?",
      "text": "One hexadecimal digit is exactly 4 bits, so two hex digits describe a byte. That's why colours look like #FF8800: one byte each for red, green and blue."
    },
    {
      "id": "twos-complement",
      "type": "fact",
      "emoji": "➖",
      "title": "Two's complement",
      "text": "Most computers store signed integers in two's complement. An 8-bit signed integer runs from −128 to 127; flipping all the bits and adding 1 negates a number."
    },
    {
      "id": "2-10",
      "type": "quiz",
      "question": "What is 2¹⁰?",
      "answer": "1,024",
      "options": ["1,000", "2,048", "512"]
    },
    {
      "id": "nibble",
      "type": "quiz",
      "question": "How many bits are in a nibble?",
      "answer": "4",
      "options": ["2", "8", "16"]
    },
    {
      "id": "uint16",
      "type": "quiz",
      "question": "What is the largest value an unsigned 16-bit integer can hold?",
      "answer": "65,535",
      "options": ["65,536", "32,767", "16,384"],
      "explanation": "2¹⁶ − 1: one less than the number of possible values, because 0 is one of them."
    },
    {
