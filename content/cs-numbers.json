    {
      "id": "kilobyte",
      "type": "myth",
      "statement": "A kilobyte (kB) is officially 1,024 bytes.",
      "isFact": false,
      "explanation": "In SI units a kilobyte is 1,000 bytes. The 1,024-byte unit is the kibibyte (KiB)."
    },
    {
      "id": "float-exact",
      "type": "myth",
      "statement": "Floating-point numbers can represent every decimal number exactly.",
      "isFact": false,
      "explanation": "Values like 0.1 have no finite binary representation, so they're stored as the nearest approximation."
    },
    {
      "id": "float-sum",
      "type": "code-output",
      "lang": "js",
      "code": ["console.log(0.1 + 0.2);"],
      "answer": "0.30000000000000004",
      "options": ["0.3", "0.30000000000000001", "0.2999999999999999"],
      "explanation": "Neither 0.1 nor 0.2 is exact in binary floating point, and the tiny errors add up."
    },
    {
      "id": "floor-div",
      "type": "code-output",
      "lang": "python",
      "code": ["print(-7 // 2, -7 % 2)"],
      "answer": "-4 1",
      "options": ["-3 -1", "-3 1", "-4 -1"],
      "explanation": "Python's // rounds down (towards −∞), and % takes the sign of the divisor."
    },
    {
      "id": "bitwise",
      "type": "code-output",
      "lang": "js",
      "code": ["console.log(5 & 3, 5 | 3, 5 ^ 3);"],
      "answer": "1 7 6",
      "options": ["8 7 6", "1 8 2", "3 5 7"],
      "explanation": "5 is 101 and 3 is 011: AND gives 001, OR gives 111, XOR gives 110."
    },
    {
      "id": "radix",
      "type": "code-output",
      "lang": "js",
      "code": ["console.log((255).toString(16));", "console.log(parseInt(\"1010\", 2));"],
      "answer": "ff\n10",
      "options": ["FF\n10", "ff\n1010", "0xff\n10"],
      "explanation": "toString(16) gives lowercase hex; parseInt with radix 2 reads binary."
    },
    {
      "id": "literals",
      "type": "code-output",
      "lang": "python",
      "code": ["print(1 << 4, 0b1010, 0x1F)"],
      "answer": "16 10 31",
      "options": ["5 10 31", "16 1010 1F", "16 10 15"],
      "explanation": "Shifting 1 left by 4 doubles it four times; 0b and 0x literals are binary and hex."
