      "answer": "53 2",
      "options": ["8 2", "53 NaN", "8 8"],
      "explanation": "+ with a string concatenates; - only works on numbers, so \"5\" is converted."
    },
    {
      "id": "event-loop",
      "type": "code-output",
      "lang": "js",
      "code": [
        "setTimeout(() => console.log(\"A\"), 0);",
        "Promise.resolve().then(() =>",
        "  console.log(\"B\"));",
        "console.log(\"C\");"
      ],
      "answer": "C\nB\nA",
      "options": ["A\nB\nC", "C\nA\nB", "B\nC\nA"],
      "explanation": "Synchronous code runs first, then microtasks (promise callbacks), then timers."
    },
    {
      "id": "mutable-default",
      "type": "code-output",
      "lang": "python",
      "code": ["def add(x, items=[]):", "    items.append(x)", "    return items", "", "add(1)", "print(add(2))"],
      "answer": "[1, 2]",
      "options": ["[2]", "[1]", "[2, 1]"],
      "explanation": "The default list is created once, when the function is defined, and shared by every call."
    },
    {
      "id": "slicing",
      "type": "code-output",
      "lang": "python",
      "code": ["s = \"boonscrolling\"", "print(s[::-1][:4])"],
      "answer": "gnil",
      "options": ["boon", "ling", "noob"],
      "explanation": "[::-1] reverses the string, then [:4] takes its first four characters."
    },
    {
      "id": "closures",
      "type": "code-output",
      "lang": "js",
      "code": [
        "const fs = [];",
        "for (var i = 0; i < 3; i++) {",
        "  fs.push(() => i);",
        "}",
        "console.log(fs.map(f => f()).join());"
      ],
      "answer": "3,3,3",
      "options": ["0,1,2", "1,2,3", "2,2,2"],
      "explanation": "var is function-scoped, so every closure sees the same i, which is 3 after the loop. let would give 0,1,2."
    },
    {
      "id": "aliasing",
      "type": "code-output",
      "lang": "python",
      "code": ["a = [1, 2, 3]", "b = a", "b.append(4)", "print(len(a))"],
      "answer": "4",
      "options": ["3", "1", "Error"],
      "explanation": "b = a copies the reference, not the list: both names point at the same object."
    },
